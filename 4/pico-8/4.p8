pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- 4: gyri -- phase 7: visuals & sound polish (play-test follow-up)

CX,CY=64,55
SR=64
SC=0.19167
ST=0.00556
FCD=4
SSPD=4
ER={40,30,20}
EB={0.13889,0.11111,0.08333}
ESPD=0.0007
RGR=1
LX,RX,D1Y=32,96,12
TX,TY=64,12
D1R=10
CSPD=0.01
ND1=360
ND2=360
DVSPD=3
ESSPD=3
SA1=0.03333
SA2=0.10278
SL1=0.0639
SL2=0.1278
GD0=4
GGR=1.6
GN=7
GP1={3,2,3,2,1,2}
GP2={3,2,1,2}
GP3={1,2,1,2}
WT={8,11,12,2}
WA={13,3,6,5}
ESP={1,7,8}
WZ1=20
WZ2=15
WZ3=10
WZ4=30
WZ5=15
PZ=12

-- lib/math.lua
-- pico-8's sin() is inverted (sin(x)==-sin(2*pi*x)) for its y-down screen
-- convention; negate the sin term so increasing a sweeps rightward. the
-- cos term is added, not subtracted, since the arc is a valley opening
-- upward (implied centre above the screen) rather than a dome.
function arc_xy(cx,cy,r,a)
  return cx-r*sin(a),cy+r*cos(a)
end

-- draws a horizontal dashed line at row y: pat is a run-length list
-- alternating lit/unlit segments in px, starting lit
function dline(y,pat)
  local x,pi,on=0,1,true
  while x<128 do
    local ln=pat[pi]
    if on then line(x,y,min(127,x+ln-1),y,1) end
    x+=ln
    pi=pi%#pat+1
    on=not on
  end
end

-- lib/screen.lua
-- call: if blink(2) then print("press x to start",...) end
function blink(hz)
  return (time()*hz)%2<1
end

-- lib/title.lua
-- call from _draw(): if gs==0 then draw_title_card("GYRI #4") return end
function draw_title_card(name)
  cls(5)
  local sw={7,10,11,3,6,8,1,0}
  for i=0,7 do
    rectfill(30+i*9,8,34+i*9,14,sw[i+1])
  end
  local l1="'26 WARPED GAME JAM"
  print(l1,64-#l1*2,26,7)
  print("PRESENTS",48,34,7)
  print(name,64-#name*2,62,7)
  if blink(2) then
    local l2="PRESS X TO START"
    print(l2,64-#l2*2,104,7)
  end
end

function any_btnp()
  for i=0,5 do
    if btnp(i) then return true end
  end
  return false
end

function shsp(th)
  local a=abs(th)
  return a<SA1 and 2 or (a<SA2 and 3 or 4)
end

function shipspr(th)
  local a=abs(th)
  return a<SL1 and 0 or (a<SL2 and 5 or 6)
end

function zoompos()
  if ws==1 then
    local p=1-frz/WZ1
    return zx0+(CX-zx0)*p,zy0+(CY-zy0)*p
  else
    local p=1-frz/WZ2
    return CX+(TX-CX)*p,CY+(TY-CY)*p
  end
end

function spawn_wave()
  local php=10+5*(wv-1)
  pl={{x=LX,hp=php},{x=RX,hp=php}}
  local n=min(24,18+2*(wv-1))
  local t1=flr(n*7/18+0.5)
  local t2=flr(n*6/18+0.5)
  local cnt={t1,t2,n-t1-t2}
  local idx=0
  for t=1,3 do
    for i=1,cnt[t] do
      local ea=-EB[t]+2*EB[t]*(i-1)/(cnt[t]-1)
      local ex=idx%2==0 and LX or RX
      add(en,{tr=t,ea=ea,dir=1,r=0,ca=idx/n,x=ex,y=D1Y,dex=ex,dey=D1Y,dv=0,mc=0,fc=rnd(90)})
      idx+=1
    end
  end
  local ndiv=min(5,wv)
  for i=1,ndiv do
    local j
    repeat j=flr(rnd(n))+1 until en[j].dt==nil
    en[j].dt=20+(i-1)*40
  end
end

function start_dive(e,shx,shy,ed)
  e.dv=1
  e.ed=ed
  sfx(3)
  e.dvsg=e.ea<0 and -1 or 1
  local ddx,ddy=shx-e.x,shy-e.y
  local dl=max(1,sqrt(ddx*ddx+ddy*ddy))
  local sp=DVSPD*(1+0.08*(wv-1))*min(2,1+0.15*e.mc)
  e.dvx=ddx/dl*sp
  e.dvy=ddy/dl*sp
end

function end_dive(e)
  e.dv=0
  if e.ed==0 then
    e.ea=e.dvsg*EB[e.tr]
    e.dir=-e.dvsg
    e.r=ER[e.tr]
  end
end

function newgame()
  sang=0
  ft=0
  shots={}
  eshots={}
  en={}
  pt={}
  ET=0
  lv=5
  wv=1
  sc=0
  gs=1
  spawn_wave()
end

function _init()
  gs=0
end

function _update()
  if gs==0 then
    if any_btnp() then newgame() end
    return
  end
  if gs==3 then
    if any_btnp() then gs=0 end
    return
  end
  if gs==2 then
    if pz>0 then
      pz-=1
      if pz<=0 then
        ws+=1
        if ws==2 then frz=WZ2
        elseif ws==3 then frz=WZ3
        elseif ws==4 then
          frz=WZ4
          wv+=1
          ET=0
          en={}
          eshots={}
          pt={}
          sang=0
          trail={}
          spawn_wave()
        end
      end
      return
    end
    frz-=1
    if ws<=2 then
      local zx,zy=zoompos()
      local frac=WZ1/(WZ1+WZ2)
      local p=ws==1 and (1-frz/WZ1)*frac or frac+(1-frz/WZ2)*(1-frac)
      local zc=p<0.33 and 1 or (p<0.66 and 6 or 7)
      add(trail,{x=zx,y=zy,c=zc})
    end
    if frz<=0 then
      if ws<4 then
        pz=PZ
        sfx(6+ws)
      elseif ws==4 then
        ws=5
        frz=WZ5
      else gs=1
      end
    end
    return
  end

  if btn(0) then sang=max(-SC,sang-ST) end
  if btn(1) then sang=min(SC,sang+ST) end
  local shx,shy=arc_xy(CX,CY,SR,sang)

  if ft>0 then ft-=1 end
  if btn(4) and ft<=0 then
    ft=FCD
    local dx,dy=arc_xy(0,0,-1,sang)
    add(shots,{x=shx,y=shy,vx=dx*SSPD,vy=dy*SSPD,sp=shsp(sang),fx=sang>0})
    sfx(0)
  end

  for i=#shots,1,-1 do
    local s=shots[i]
    s.x+=s.vx
    s.y+=s.vy
    if s.x<0 or s.x>127 or s.y<0 or s.y>127 then
      del(shots,s)
    end
  end

  ET+=1
  local wfc=max(20,90-5*(wv-1))
  local dch=min(0.5,0.05+0.015*(wv-1))
  local espd=ESPD*(1+0.08*(wv-1))
  for e in all(en) do
    if e.dv==1 then
      e.x+=e.dvx
      e.y+=e.dvy
      if abs(e.x-shx)<3 and abs(e.y-shy)<3 then
        lv=max(0,lv-1)
        sfx(2)
        end_dive(e)
      elseif e.x<0 or e.x>127 or e.y<0 or e.y>127 then
        e.mc=min(7,e.mc+1)
        end_dive(e)
      end
    elseif e.dt and e.dt==ET then
      start_dive(e,shx,shy,1)
    else
      e.ea+=espd*e.dir
      local b=EB[e.tr]
      if e.ea>b then
        e.ea=b
        e.dir=-1
      elseif e.ea<-b then
        e.ea=-b
        e.dir=1
      end
      e.ca+=CSPD
      if ET<ND1 then
        e.x,e.y=arc_xy(e.dex,e.dey,D1R,e.ca)
      elseif ET<ND1+ND2 then
        local p=(ET-ND1)/ND2
        local cx1,cy1=arc_xy(e.dex,e.dey,D1R,e.ca)
        e.x=cx1+(CX-cx1)*p
        e.y=cy1+(CY-cy1)*p
      else
        if e.r<ER[e.tr] then e.r=min(ER[e.tr],e.r+RGR) end
        e.x,e.y=arc_xy(CX,CY,e.r,e.ea)
        if e.r>=ER[e.tr] then
          if e.fc>0 then e.fc-=1 end
          if e.fc<=0 and #en+#eshots<32 then
            e.fc=max(20,wfc-10*e.mc)
            local dx,dy=arc_xy(0,0,1,e.ea)
            add(eshots,{x=e.x,y=e.y,vx=dx*ESSPD,vy=dy*ESSPD,sp=shsp(e.ea),fx=e.ea<0})
          end
          if rnd(1)<dch/30 then start_dive(e,shx,shy,0) end
        end
      end
    end
  end

  for i=#eshots,1,-1 do
    local s=eshots[i]
    s.x+=s.vx
    s.y+=s.vy
    if abs(s.x-shx)<3 and abs(s.y-shy)<3 then
      lv=max(0,lv-1)
      sfx(2)
      del(eshots,s)
    elseif s.x<0 or s.x>127 or s.y<0 or s.y>127 then
      del(eshots,s)
    end
  end

  for i=#shots,1,-1 do
    local s=shots[i]
    for j=#en,1,-1 do
      local e=en[j]
      if abs(s.x-e.x)<3 and abs(s.y-e.y)<3 then
        sc+=50*e.tr+(e.dv==1 and 50 or 0)
        sfx(1)
        for k=1,5 do
          local pa=rnd(1)
          add(pt,{x=e.x,y=e.y,vx=cos(pa)*rnd(1.5),vy=sin(pa)*rnd(1.5),t=10+rnd(5)})
        end
        del(shots,s)
        del(en,e)
        break
      end
    end
  end

  for i=#shots,1,-1 do
    local s=shots[i]
    for j=1,2 do
      local p=pl[j]
      if p.hp>0 and abs(s.y-D1Y)<3 and abs(s.x-p.x)<3 then
        p.hp-=1
        sc+=200
        if p.hp<=0 then
          sfx(1)
          for k=1,14 do
            local pa=rnd(1)
            add(pt,{x=p.x,y=D1Y,vx=cos(pa)*rnd(3),vy=sin(pa)*rnd(3),t=15+rnd(15),c=10})
          end
        else
          sfx(6)
          for k=1,5 do
            local pa=rnd(1)
            add(pt,{x=p.x,y=D1Y,vx=cos(pa)*rnd(1.5),vy=sin(pa)*rnd(1.5),t=10+rnd(5),c=10})
          end
        end
        del(shots,s)
        break
      end
    end
  end

  for i=#pt,1,-1 do
    local p=pt[i]
    p.x+=p.vx
    p.y+=p.vy
    p.t-=1
    if p.t<=0 then del(pt,p) end
  end

  if lv<=0 then
    gs=3
    sfx(5)
  elseif #en==0 then
    ws=1
    frz=WZ1
    pz=0
    zx0,zy0=shx,shy
    trail={}
    gs=2
    sfx(4)
  end
end

function draw_end()
  cls(0)
  print("game over",44,50,8)
  print("score "..sc,40,64,7)
  print("wave "..wv,40,74,7)
  if blink(2) then
    print("press x",44,100,7)
  end
end

function draw_backdrop()
  local d=GD0
  for i=1,GN do
    local pat=i<=3 and GP1 or (i<=5 and GP2 or GP3)
    dline(CY-d,pat)
    line(0,CY+d,127,CY+d,1)
    d*=GGR
  end
  line(0,120,127,120,7)
  for i=-2,2 do
    local ex,ey=arc_xy(CX,CY,200,SC*i/2)
    line(CX,CY,ex,ey,1)
  end
  circfill(CX,CY,2,1)
end

function draw_trail()
  for i=2,#trail do
    line(trail[i-1].x,trail[i-1].y,trail[i].x,trail[i].y,trail[i].c)
  end
end

function draw_game()
  draw_backdrop()
  if pl[1].hp>0 then spr(10,pl[1].x-4,D1Y-4) end
  if pl[2].hp>0 then spr(10,pl[2].x-4,D1Y-4) end
  local ecol=WT[(wv-1)%4+1]
  local acol=WA[(wv-1)%4+1]
  pal(8,ecol)
  pal(12,acol)
  for e in all(en) do
    local edx,edy=e.x-CX,e.y-CY
    local ds=mid(1,(50-sqrt(edx*edx+edy*edy))/10,3)*3
    local sp=e.dv==1 and 9 or ESP[e.tr]
    sspr(sp*8,0,8,8,e.x-ds/2,e.y-ds/2,ds,ds)
  end
  pal()
  local sx,sy=arc_xy(CX,CY,SR,sang)
  spr(shipspr(sang),sx-4,sy-4,1,1,sang>0,false)
  for s in all(shots) do
    sspr(s.sp*8,0,8,8,s.x-2,s.y-2,4,4,s.fx,false)
  end
  pal(7,ecol)
  for s in all(eshots) do
    sspr(s.sp*8,0,8,8,s.x-2,s.y-2,4,4,s.fx,true)
  end
  pal()
  for p in all(pt) do
    pset(p.x,p.y,p.c or ecol)
  end
  print("lv"..lv,2,121,7)
  local ss="sc"..sc
  print(ss,64-#ss*2,121,7)
  local wst="w"..wv
  print(wst,126-#wst*4,121,7)
end

function _draw()
  if gs==0 then draw_title_card("GYRI #4") return end
  if gs==3 then draw_end() return end
  cls(0)
  if gs==2 then
    if ws<=2 then
      draw_backdrop()
      draw_trail()
      local zx,zy=zoompos()
      if ws==1 and pz>0 then
        circfill(zx,zy,3+2*sin(time()*4),10)
      end
      spr(0,zx-4,zy-4)
    elseif ws==3 then
      draw_backdrop()
      draw_trail()
      circfill(TX,TY,140*(1-frz/WZ3),7)
    elseif ws==4 then
      cls(7)
      local wl="new wave "..wv
      print(wl,64-#wl*2,60,WT[(wv-1)%4+1])
    else
      draw_game()
      circfill(TX,TY,140*frz/WZ5,7)
    end
    return
  end
  draw_game()
end

