pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- 5: 5 to the top -- phase 5: screens, flow & progression

-- lib/screen.lua
function blink(hz)
 return (time()*hz)%2<1
end

-- lib/title.lua
function draw_title_card(name)
 cls(5)
 local sw={7,10,11,3,6,8,1,0}
 for i=0,7 do
  rectfill(30+i*9,8,34+i*9,14,sw[i+1])
 end
 local l1="'26 WARPED GAME JAM"
 print(l1,64-#l1*2,26,7)
 print("PRESENTS",48,34,7)
 print(name,64-#name*2,62,7)
 if blink(2) then
  local l2="PRESS X TO START"
  print(l2,64-#l2*2,104,7)
 end
end

haz_spr={5,6,7,8} -- tumbleweed, barrel, hazard bottle, wagon wheel sprite indices
box_chance=0.15
gy=328 -- ground row world-y (row idx -1)
rope_l=20
rope_amp=0.15
rope_freq=0.425 -- 0.5 * 0.85, 15% slower
prize_int=450 -- 15s between prize spawns
gun_dur=300 -- 10s gun timer
gun_cd_max=6 -- fire rate limit
shot_spd=4
base_haz_spd=1.2
trans_dur=18 -- level-transition flicker length, frames

-- row idx -1=ground(328) .. 0..8=platform1..9 .. 9=finish (296..8, 32px pitch)
function rowy(idx)
 return 296-32*idx
end

function gen_level()
 tiles={}
 for r=0,9 do
  local row={}
  for c=0,15 do
   row[c]=(rnd(1)<gapd) and 0 or 1
  end
  tiles[r]=row
 end
 conn={}
 for p=0,9 do
  local lo=p-1
  local hi=p
  local cands={}
  for c=0,15 do
   local lo_ok=(lo==-1) or tiles[lo][c]==1
   local hi_ok=tiles[hi][c]==1
   if lo_ok and hi_ok then add(cands,c) end
  end
  local col
  if #cands>0 then
   col=cands[flr(rnd(#cands))+1]
  else
   col=flr(rnd(16))
   if lo>=0 then tiles[lo][col]=1 end
   tiles[hi][col]=1
  end
  conn[p]={col=col}
 end
 boxed={}
 for r=0,9 do
  local excl={[conn[r].col]=true}
  if r<9 then excl[conn[r+1].col]=true end
  local brow={}
  for c=0,15 do
   local clear_l=(c==0) or tiles[r][c-1]==1
   local clear_r=(c==15) or tiles[r][c+1]==1
   brow[c]=(tiles[r][c]==1 and not excl[c] and clear_l and clear_r and rnd(1)<box_chance)
  end
  boxed[r]=brow
 end
 local rp=flr(rnd(10))
 local excl2={[conn[rp].col]=true}
 for c=0,15 do
  if boxed[rp][c] then excl2[c]=true end
  if rp>0 and boxed[rp-1][c] then excl2[c]=true end
 end
 local cands2={}
 for c=0,15 do
  if not excl2[c] then add(cands2,c) end
 end
 if #cands2==0 then
  for c=0,15 do
   if c!=conn[rp].col then add(cands2,c) end
  end
 end
 local rc=cands2[flr(rnd(#cands2))+1]
 local hi_y2=rowy(rp)
 rope={p=rp,col=rc,ax=rc*8+4,ay=hi_y2+8}
 local fcands={}
 for c=0,15 do
  if tiles[9][c]==1 and not boxed[9][c] then add(fcands,c) end
 end
 local fc=fcands[flr(rnd(#fcands))+1]
 finish={x=fc*8,y=rowy(9)-8}
 build_solids()
end

function build_solids()
 solids={}
 for c=0,15 do
  add(solids,{x=c*8,y=gy,w=8,h=8})
 end
 for r=0,9 do
  for c=0,15 do
   if tiles[r][c]==1 then
    add(solids,{x=c*8,y=rowy(r),w=8,h=8})
   end
   if boxed[r][c] then
    add(solids,{x=c*8,y=rowy(r)-8,w=8,h=8})
   end
  end
 end
end

function solid_at(x,y,w,h)
 for s in all(solids) do
  if x<s.x+s.w and x+w>s.x and y<s.y+s.h and y+h>s.y then
   return s
  end
 end
 return nil
end

function try_grab_ladder()
 for p=0,9 do
  local c=conn[p].col
  local lo_y=(p==0) and gy or rowy(p-1)
  local hi_y=rowy(p)
  if px+4>=c*8 and px+4<c*8+8 and py<=lo_y and py>=hi_y then
   if btn(2) or btn(3) then
    climbing=true
    climb_p=p
    px=c*8
    pvy=0
   end
  end
 end
end

function upd_climb()
 local p=climb_p
 local lo_y=(p==0) and gy or rowy(p-1)
 local hi_y=rowy(p)
 if btn(2) then
  py=py-1
  if flr(time()*30)%6==0 then sfx(1) end
 end
 if btn(3) then
  py=py+1
  if flr(time()*30)%6==0 then sfx(1) end
 end
 if py<hi_y then
  py=hi_y
  climbing=false
  ongnd=true
 elseif py>lo_y then
  py=lo_y
  climbing=false
  ongnd=true
 end
 if btnp(4) then climbing=false end
end

function rope_theta()
 return rope_amp*sin(rope_freq*time())
end

function try_grab_rope()
 local lo_y=(rope.p==0) and gy or rowy(rope.p-1)
 local hi_y=rowy(rope.p)
 if abs(px+4-rope.ax)<16 and py<=lo_y+8 and py>=hi_y-8 then
  if btn(2) then
   swinging=true
   sfx(2)
  end
 end
end

function upd_swing()
 local ppx,ppy=px,py
 local theta=rope_theta()
 px=rope.ax+rope_l*sin(theta)-4
 py=rope.ay+rope_l*cos(theta)-4
 if btnp(4) or btnp(5) then
  swinging=false
  pvx=px-ppx
  pvy=py-ppy
  ongnd=false
  sfx(3)
 end
end

function upd_player()
 if climbing then
  upd_climb()
  return
 end
 if swinging then
  upd_swing()
  return
 end
 local dx=0
 if btn(0) then dx=-1.5 facing=-1 end
 if btn(1) then dx=1.5 facing=1 end
 if pvx then
  dx=dx+pvx
  pvx=pvx*0.85
  if abs(pvx)<0.05 then pvx=nil end
 end
 if dx!=0 then
  local nx=mid(0,px+dx,120)
  local s=solid_at(nx,py,8,8)
  if s then
   if dx<0 then px=s.x+s.w
   else px=s.x-8 end
  else
   px=nx
  end
 end
 pvy=min(pvy+0.35,5)
 if ongnd and btnp(4) then
  pvy=-3
  ongnd=false
  sfx(0)
 end
 local ny=py+pvy
 local s=solid_at(px,ny,8,8)
 if s then
  if pvy>=0 then
   py=s.y-8
   ongnd=true
  else
   py=s.y+s.h
  end
  pvy=0
 else
  py=ny
  ongnd=false
 end
 try_grab_ladder()
 try_grab_rope()
end

function spawn_hazard()
 local col=flr(rnd(16))
 add(hazards,{
  x=col*8,
  y=0,
  typ=flr(rnd(4))+1,
  dir=(rnd(1)<0.5) and -1 or 1,
  rolling=false,
  nr=9
 })
end

function upd_hazards()
 spawn_t-=1
 if spawn_t<=0 then
  spawn_hazard()
  spawn_t=spawn_int
 end
 for h in all(hazards) do
  if h.rolling then
   local nx=h.x+haz_spd*h.dir
   local c=flr((nx+4)/8)
   if c<0 or c>15 then
    h.dir=-h.dir
   elseif tiles[h.row][c]==0 then
    h.x=nx
    h.rolling=false
    h.nr=h.row-1
   else
    h.x=nx
   end
  else
   h.y+=haz_spd
   if h.nr>=0 and h.y+8>=rowy(h.nr) then
    local c=flr((h.x+4)/8)
    if tiles[h.nr][c]==1 then
     h.rolling=true
     h.row=h.nr
     h.y=rowy(h.nr)-8
    else
     h.nr-=1
    end
   end
   if h.y>gy+8 then
    del(hazards,h)
   end
  end
 end
end

function upd_life()
 if inv_t>0 then
  inv_t-=1
  return
 end
 for h in all(hazards) do
  if px<h.x+8 and px+8>h.x and py<h.y+8 and py+8>h.y then
   lives-=1
   inv_t=30
   sfx(4)
   if lives<=0 then gs=3 sfx(12) end
   break
  end
 end
end

function spawn_prize()
 local cands={}
 for r=0,9 do
  for c=0,15 do
   if tiles[r][c]==1 and not boxed[r][c] then
    add(cands,{r=r,c=c})
   end
  end
 end
 if #cands==0 then return end
 local pick=cands[flr(rnd(#cands))+1]
 local kind=(rnd(1)<0.5) and "gun" or "bottle"
 add(prizes,{x=pick.c*8,y=rowy(pick.r)-8,kind=kind,good=rnd(1)<0.5})
end

function upd_prizes()
 prize_t-=1
 if prize_t<=0 then
  spawn_prize()
  prize_t=prize_int
 end
 for pr in all(prizes) do
  if px<pr.x+8 and px+8>pr.x and py<pr.y+8 and py+8>pr.y then
   if pr.kind=="gun" then
    gun_t=gun_dur
    gun_cd=0
    sfx(7)
   elseif pr.good then
    lives+=1
    sfx(5)
   else
    lives-=1
    sfx(6)
    if lives<=0 then gs=3 sfx(12) end
   end
   del(prizes,pr)
  end
 end
end

function upd_gun()
 if gun_t>0 then
  gun_t-=1
  if gun_t==30 then sfx(9) end
  if gun_cd>0 then gun_cd-=1 end
  if btn(5) and gun_cd<=0 then
   add(shots,{x=(facing>0) and px+8 or px-4,y=py+2,dir=facing})
   gun_cd=gun_cd_max
   sfx(8)
  end
 end
 for s in all(shots) do
  s.x+=shot_spd*s.dir
  local hit=nil
  for h in all(hazards) do
   if s.x<h.x+8 and s.x+4>h.x and s.y<h.y+8 and s.y+4>h.y then
    hit=h
    break
   end
  end
  if hit then
   del(hazards,hit)
   del(shots,s)
   score+=10
   sfx(10)
  elseif s.x<-8 or s.x>136 then
   del(shots,s)
  end
 end
end

function upd_camera()
 camera_y=mid(0,py-56,gy-104)
end

function new_level()
 gapd=min(0.35,0.15+0.02*(level-1))
 spawn_int=max(30,90-5*(level-1))
 haz_spd=base_haz_spd*min(2,1+0.1*(level-1))
 gen_level()
 px=60
 py=gy-8
 pvy=0
 pvx=nil
 ongnd=true
 climbing=false
 swinging=false
 hazards={}
 spawn_t=spawn_int
 prizes={}
 prize_t=prize_int
 gun_t=0
 gun_cd=0
 shots={}
 inv_t=0
 camera_y=gy-104
 facing=1
end

function new_game()
 lives=3
 score=0
 level=1
 new_level()
end

function any_btnp()
 for i=0,5 do
  if btnp(i) then return true end
 end
 return false
end

function upd_title()
 if any_btnp() then
  new_game()
  gs=1
 end
end

function upd_playing()
 upd_player()
 upd_hazards()
 upd_life()
 upd_prizes()
 upd_gun()
 upd_camera()
 if gs==1 and px<finish.x+8 and px+8>finish.x and py<finish.y+8 and py+8>finish.y then
  score+=100
  gs=2
  trans_t=trans_dur
  sfx(11)
 end
end

function upd_transition()
 trans_t-=1
 if trans_t<=0 then
  level+=1
  new_level()
  gs=1
 end
end

function upd_end()
 if any_btnp() then
  gs=0
 end
end

function _init()
 gs=0
end

function _update()
 if gs==0 then upd_title()
 elseif gs==1 then upd_playing()
 elseif gs==2 then upd_transition()
 elseif gs==3 then upd_end()
 end
end

function draw_conn(p)
 local cn=conn[p]
 local c=cn.col
 local lo_y=(p==0) and gy or rowy(p-1)
 local hi_y=rowy(p)
 for y=hi_y,lo_y-1,3 do
  line(c*8+2,y,c*8+2,y+1,9)
  line(c*8+5,y,c*8+5,y+1,9)
 end
end

function draw_playing()
 cls(0)
 camera(0,camera_y)
 for r=0,9 do
  for c=0,15 do
   if tiles[r][c]==1 then
    spr(3,c*8,rowy(r))
   end
  end
 end
 rectfill(0,gy,127,gy+7,4)
 for p=0,9 do
  draw_conn(p)
 end
 local rtheta=rope_theta()
 line(rope.ax,rope.ay,rope.ax+rope_l*sin(rtheta),rope.ay+rope_l*cos(rtheta),10)
 if blink(3) then
  spr(12,finish.x,finish.y)
 end
 for h in all(hazards) do
  spr(haz_spr[h.typ],h.x,h.y)
 end
 for r=0,9 do
  for c=0,15 do
   if boxed[r][c] then
    spr(4,c*8,rowy(r)-8)
   end
  end
 end
 for pr in all(prizes) do
  local pspr=9
  if pr.kind=="bottle" then pspr=pr.good and 10 or 11 end
  spr(pspr,pr.x,pr.y)
 end
 for s in all(shots) do
  rectfill(s.x,s.y,s.x+3,s.y+3,7)
 end
 if inv_t<=0 or inv_t%4<2 then
  local moving=btn(0) or btn(1) or climbing
  local pframe=(moving and flr(time()*8)%2==0) and 2 or 1
  spr(pframe,px,py,1,1,facing<0)
 end
 camera(0,0)
end

function draw_hud()
 print("lives "..lives,2,116,7)
 local lvl="lvl "..level
 print(lvl,64-#lvl*2,116,7)
 local sc="score "..score
 print(sc,125-#sc*4,116,7)
 if gun_t>0 then
  print("gun:"..flr(gun_t/30),2,120,7)
 end
end

function _draw()
 if gs==0 then
  draw_title_card("5 TO THE TOP")
 elseif gs==1 then
  draw_playing()
  draw_hud()
 elseif gs==2 then
  draw_playing()
  if trans_t%2==0 then
   rectfill(0,0,127,111,7)
  else
   rectfill(0,0,127,111,0)
  end
  local lt="level "..(level+1)
  print(lt,64-#lt*2,52,0)
  draw_hud()
 elseif gs==3 then
  cls(0)
  print("game over",44,40,8)
  print("score "..score,40,56,7)
  print("levels cleared "..(level-1),24,64,7)
  if blink(2) then
   print("press any button",28,104,7)
  end
 end
end

